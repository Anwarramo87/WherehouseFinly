# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local debug sessions (trae / IDE debug tooling)
.dbg/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
package-lock.json

# worktrees
.worktrees/

# temp/test artifacts — never commit
tmp/
test-*.ps1
test-*.js
res2.txt
*.zip
*.rar
*.bak
Screenshot*.png
query-emp*.sql
query-emp*.ts
list-tables.sql
docs/
